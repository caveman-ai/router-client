{
  "name": "@caveman-ai/router-codex",
  "version": "0.1.0",
  "description": "Codex CLI hooks for caveman-routerd: prompt prefetch, tool outcomes, and spawn_agent model + effort steering.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
