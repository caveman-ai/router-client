  "description": "Caveman Router subagent hook for Claude Code: routes Agent/Task spawns to the cheapest model that can do the job.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
