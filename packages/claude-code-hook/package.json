  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "test": "node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caveman-ai/router-client.git",
    "directory": "packages/claude-code-hook"
  },
  "homepage": "https://github.com/caveman-ai/router-client#readme",
  "bugs": {
